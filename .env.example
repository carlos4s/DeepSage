ANTHROPIC_API_KEY=your-anthropic-key
OPENAI_API_KEY=your-openai-key

# Optional: if set, Serper is used; otherwise we fall back to DuckDuckGo.
SERPER_API_KEY=

# Each role has a provider (anthropic | openai) and a model name.
PLANNER_MODEL_PROVIDER=anthropic
PLANNER_MODEL=claude-sonnet-4-6
REFLECT_MODEL_PROVIDER=anthropic
REFLECT_MODEL=claude-sonnet-4-6
WRITER_MODEL_PROVIDER=anthropic
WRITER_MODEL=claude-sonnet-4-6

# Research budget
MAX_ITERATIONS=4
RESULTS_PER_SEARCH=5
FETCH_CHAR_LIMIT=6000
